# Copy to .env on the server (next to docker-compose.yml) and fill in.
# Never commit the real file.

# --- where the app lives ------------------------------------------------------
# Point an A record for this name at the server's IP before starting.
DOMAIN=finpilot.example.com

# --- the model ------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_AGENT_MODEL=gemini-3.5-flash
GEMINI_NAMING_MODEL=gemini-3.5-flash-lite
LLM_ENABLED=true
AGENT_ENABLED=true

# --- payments (Razorpay) -----------------------------------------------------------
# Use test keys first (rzp_test_...), then live keys once Razorpay activates
# your account. Leave PAYMENTS_DEV_MODE off in production: it upgrades users
# without payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENTS_DEV_MODE=false

# --- email (password reset) -------------------------------------------------------------
# Any SMTP provider: Amazon SES, Resend, Brevo, Zoho, Google Workspace...
# Without it, reset links are only written to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FinPilot <no-reply@finpilot.example.com>

# --- data protection ---------------------------------------------------------------------
# Each upload (files, ledger, habits, reports) is erased this many days after its analysis,
# unless a Pro user extends it. Users get emails 7 days and 1 day before.
UPLOAD_RETENTION_DAYS=30

# --- plans ---------------------------------------------------------------------------
FREE_CHAT_PER_MONTH=10
FREE_REPORTS_PER_MONTH=1
FREE_FILES_PER_MONTH=50
PRICE_PRO_MONTHLY_PAISE=14900
PRICE_PRO_YEARLY_PAISE=99900

MAX_UPLOAD_MB=50
