# FinPilot -- copy to .env and fill in.
# The backend reads this file from the repo root (and from finpilot/backend/.env).

# ---------------------------------------------------------------------------
# Gemini
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Ingestion uses NO model at all -- every document is read by code, so a
# missing key costs you nothing until you segment. The only model call in
# FinPilot names the segments clustering has already found, and it sees the
# aggregate profile of a cluster, never a transaction.
#
# Model ids are NEVER hardcoded in the source -- Google renames and retires
# them. Check https://ai.google.dev/gemini-api/docs/models.
#
# GEMINI_NAMING_MODEL   a Flash-Lite class model. One short call per segment.
#
# Value below was current at the time of writing; verify before relying on it.
GEMINI_NAMING_MODEL=gemini-3.5-flash-lite

# Safety rail: a single job may never make more than this many model calls.
LLM_MAX_CALLS_PER_JOB=50
LLM_TIMEOUT_SECONDS=30
# Set to false to skip the model entirely. Segments are then named from their
# own profiles by rule, which is also what happens when no key is set.
LLM_ENABLED=true

# ---------------------------------------------------------------------------
# Query agent + financial report
# ---------------------------------------------------------------------------
# The "Ask FinPilot" chat and the downloadable financial report are a Gemini
# tool-calling agent: it plans, queries the ledger / segments / bills, searches
# the uploaded documents (vector index below), and writes the answer.
# Independent of LLM_ENABLED (which only governs segment naming). Needs the key.
AGENT_ENABLED=true
GEMINI_AGENT_MODEL=gemini-3.5-flash
# Tool-calling rounds before the agent must answer with what it has.
AGENT_MAX_STEPS=8
REPORT_MAX_STEPS=16
AGENT_TEMPERATURE=0.7

# ---------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------
# Sign-in is required by default. The first account created adopts any uploads
# made before accounts existed. AUTH_REQUIRED=false = single-user local mode.
AUTH_REQUIRED=true
SESSION_DAYS=30
# true when served over HTTPS
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Plans (monthly limits) and prices (in paise)
# ---------------------------------------------------------------------------
FREE_CHAT_PER_MONTH=10
FREE_REPORTS_PER_MONTH=1
FREE_FILES_PER_MONTH=50
PRO_CHAT_PER_MONTH=300
PRO_REPORTS_PER_MONTH=20
PRO_FILES_PER_MONTH=2000
PRICE_PRO_MONTHLY_PAISE=14900
PRICE_PRO_YEARLY_PAISE=99900

# ---------------------------------------------------------------------------
# Payments (Razorpay test keys from dashboard.razorpay.com -> Settings -> API Keys)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Completes upgrades without a real payment. Local testing only.
PAYMENTS_DEV_MODE=false

# ---------------------------------------------------------------------------
# Document index (ChromaDB under DATA_DIR/vectors, local MiniLM embeddings)
# ---------------------------------------------------------------------------
# Every uploaded file is cut into masked passages and embedded locally; only
# the passages the agent retrieves for a question are sent to the model.
RAG_TOP_K=6
RAG_CHUNK_CHARS=1200
RAG_ROWS_PER_CHUNK=20

# ---------------------------------------------------------------------------
# Segmentation
# ---------------------------------------------------------------------------
# Absolute floor on how many transactions may form a segment. The clusterer
# scales this up with the size of the ledger (~2%, capped at 60).
SEGMENT_MIN_CLUSTER_SIZE=5

# ---------------------------------------------------------------------------
# Embeddings (local, no API key)
# ---------------------------------------------------------------------------
# sentence-transformers is an optional extra: `uv pip install -e ".[embeddings]"`.
# Without it, header mapping and merchant resolution fall back to rapidfuzz plus
# the LLM, which is slower but produces the same schema.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_AUTO_MAP_THRESHOLD=0.72
MERCHANT_EMBEDDING_THRESHOLD=0.80

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Uploads, exports and the SQLite database all live under DATA_DIR.
DATA_DIR=./finpilot/backend/data
# DATABASE_URL=sqlite:///./finpilot/backend/data/finpilot.db

# ---------------------------------------------------------------------------
# Matching thresholds (ingestion/link.py)
# ---------------------------------------------------------------------------
TRANSFER_DAY_WINDOW=1
RECEIPT_DAY_WINDOW=3
RECEIPT_AMOUNT_TOLERANCE=1.0
MERCHANT_FUZZY_THRESHOLD=70
REFUND_DAY_WINDOW=90

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=50

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000
